import tkinter as tk
import winsound
import copy
import json
import os

from tkinter.colorchooser import askcolor
from datetime import datetime, timedelta


# =====================================================
# Application Constants
# =====================================================

LOADOUT_DIRECTORY = "loadouts"

DEFAULT_LOADOUT_NAME = "Default"


# =====================================================
# Default Settings
# =====================================================

default_settings = {

    "lunch": {

        "hour": 12,
        "minute": 0,
        "second": 0

    },

    "audio": {

        "button_click_enabled": True

    },

    "toggles": {

        "live_preview_enabled": True,
        "always_on_top": False

    },

    "colors": {

        "current_time": "green",
        "lunch_time": "blue",
        "countdown": "black",
        "status_message": "red"

    }

}

settings = copy.deepcopy(
    default_settings
)

working_settings = None

settings_window = None


# =====================================================
# Loadout Functions
# =====================================================

def create_loadout_directory():

    os.makedirs(
        LOADOUT_DIRECTORY,
        exist_ok=True
    )


def get_loadout_path(loadout_name):

    return os.path.join(
        LOADOUT_DIRECTORY,
        f"{loadout_name}.json"
    )


def save_loadout(loadout_name):

    create_loadout_directory()

    loadout_path = get_loadout_path(
        loadout_name
    )

    with open(
        loadout_path,
        "w"
    ) as loadout_file:

        json.dump(
            settings,
            loadout_file,
            indent=4
        )


def load_loadout(loadout_name):

    global settings

    loadout_path = get_loadout_path(
        loadout_name
    )

    with open(
        loadout_path,
        "r"
    ) as loadout_file:

        settings = json.load(
            loadout_file
        )


def initialize_default_loadout():

    create_loadout_directory()

    default_path = get_loadout_path(
        DEFAULT_LOADOUT_NAME
    )

    if not os.path.exists(
        default_path
    ):

        with open(
            default_path,
            "w"
        ) as loadout_file:

            json.dump(
                default_settings,
                loadout_file,
                indent=4
            )


def initialize_application():
    
    initialize_default_loadout()
    
    load_loadout(
        DEFAULT_LOADOUT_NAME
    )


# =====================================================
# Audio Functions
# =====================================================

def play_button_click():

    if settings["audio"]["button_click_enabled"]:

        winsound.Beep(
            900,
            20
        )

        winsound.Beep(
            1000,
            20
        )


# =====================================================
# Apply Saved Settings
# =====================================================

def apply_saved_settings():

    current_time_label.config(
        fg=settings["colors"]["current_time"]
    )

    lunch_time_label.config(
        fg=settings["colors"]["lunch_time"]
    )

    countdown_value_label.config(
        fg=settings["colors"]["countdown"]
    )

    status_message_label.config(
        fg=settings["colors"]["status_message"]
    )

    root_window.attributes(
        "-topmost",
        settings["toggles"]["always_on_top"]
    )

    button_sound_enabled.set(
        settings["audio"]["button_click_enabled"]
    )

    live_preview_enabled.set(
        settings["toggles"]["live_preview_enabled"]
    )

    always_on_top_enabled.set(
        settings["toggles"]["always_on_top"]
    )


# =====================================================
# Preview Functions
# =====================================================

def apply_preview_settings():

    current_time_label.config(
        fg=working_settings["colors"]["current_time"]
    )

    lunch_time_label.config(
        fg=working_settings["colors"]["lunch_time"]
    )

    countdown_value_label.config(
        fg=working_settings["colors"]["countdown"]
    )

    status_message_label.config(
        fg=working_settings["colors"]["status_message"]
    )


# =====================================================
# Color Picker Functions
# =====================================================

def choose_current_time_color():

    play_button_click()

    selected_color = askcolor()[1]

    if selected_color:

        working_settings["colors"]["current_time"] = selected_color

        if live_preview_enabled.get():

            apply_preview_settings()


def choose_lunch_time_color():

    play_button_click()

    selected_color = askcolor()[1]

    if selected_color:

        working_settings["colors"]["lunch_time"] = selected_color

        if live_preview_enabled.get():

            apply_preview_settings()


def choose_countdown_color():

    play_button_click()

    selected_color = askcolor()[1]

    if selected_color:

        working_settings["colors"]["countdown"] = selected_color

        if live_preview_enabled.get():

            apply_preview_settings()


def choose_status_message_color():

    play_button_click()

    selected_color = askcolor()[1]

    if selected_color:

        working_settings["colors"]["status_message"] = selected_color

        if live_preview_enabled.get():

            apply_preview_settings()


# =====================================================
# Settings Functions
# =====================================================

def save_settings():

    global settings
    global settings_window

    settings = copy.deepcopy(
        working_settings
    )

    settings["audio"]["button_click_enabled"] = (
        button_sound_enabled.get()
    )

    settings["toggles"]["live_preview_enabled"] = (
        live_preview_enabled.get()
    )

    settings["toggles"]["always_on_top"] = (
        always_on_top_enabled.get()
    )

    save_loadout(
        DEFAULT_LOADOUT_NAME
    )

    apply_saved_settings()

    play_button_click()

    settings_window.destroy()

    settings_window = None


def cancel_settings():

    global working_settings
    global settings_window

    working_settings = copy.deepcopy(
        settings
    )

    apply_saved_settings()

    play_button_click()

    settings_window.destroy()

    settings_window = None


